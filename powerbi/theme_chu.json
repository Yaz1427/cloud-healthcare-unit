  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2A78D6",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#D64A6E",
  "maximum": "#1B4F8F",
